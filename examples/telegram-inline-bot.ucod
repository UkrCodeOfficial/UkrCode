# Inline-кнопки та callback queries
імпортувати Telegram

бот = Telegram.Бот(середовище("BOT_TOKEN"))

коли бот.команда("/start"):
    бот.відповісти(
        "Обери розділ:",
        inline_кнопки = [[
            {"текст": "Допомога", "дані": "help"},
            {"текст": "Про бота", "дані": "about"}
        ]]
    )

коли бот.натиснули_кнопку("help"):
    бот.відповісти("Це callback query від inline-кнопки.")

коли бот.натиснули_кнопку("about"):
    бот.відповісти("Цей бот написаний мовою UkrCode.")

бот.запустити()