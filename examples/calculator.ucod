написати("=== Калькулятор UkrCode ===")
написати("Операції: додати, відняти, помножити, поділити")
написати("Для завершення введіть: вихід")

поки так:
    перше = введення("Перше число: ")
    якщо перше == "вихід":
        написати("До побачення!")
        перервати

    операція = введення("Операція: ")
    якщо операція == "вихід":
        написати("До побачення!")
        перервати

    друге = введення("Друге число: ")
    якщо друге == "вихід":
        написати("До побачення!")
        перервати

    а = дробове(перше)
    б = дробове(друге)

    якщо операція == "додати":
        написати("Результат:", а + б)
    якщо операція == "відняти":
        написати("Результат:", а - б)
    якщо операція == "помножити":
        написати("Результат:", а * б)
    якщо операція == "поділити":
        написати("Результат:", а / б)
