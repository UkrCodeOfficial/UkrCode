# Запуск: BOT_TOKEN=ваш_токен ucod run examples/telegram-bot.ucod
імпортувати Telegram

бот = Telegram.Бот(середовище("BOT_TOKEN"))

коли бот.команда("/start"):
    бот.відповісти(
        "Привіт! Я UkrCode-бот. Обери дію:",
        кнопки = [["Допомога", "Мій профіль"], ["Про бота"]]
    )

коли бот.отримав_повідомлення():
    якщо повідомлення.текст == "Допомога":
        повідомлення.відповісти("Напиши /start, щоб знову відкрити меню.")
    інакше якщо повідомлення.текст == "Мій профіль":
        повідомлення.відповісти("Твій профіль отримано через Telegram Bot API.")
    інакше якщо повідомлення.текст == "Про бота":
        повідомлення.відповісти("Я написаний українською мовою UkrCode.")
    інакше якщо повідомлення.текст == "привіт":
        повідомлення.відповісти("Привіт! Натисни /start для меню.")
    інакше:
        повідомлення.відповісти("Не знаю такої команди. Натисни /start.")

бот.запустити()