# Магазин послуг для Roblox Studio.
# Налаштування .env:
# BOT_TOKEN=новий_токен
# ADMIN_IDS=123456789,987654321
імпортувати Telegram
імпортувати Списки
імпортувати JSON

бот = Telegram.Бот(середовище("BOT_TOKEN"))

функція меню(адмін):
    кнопки = [[
        {"текст": "Каталог", "дані": "catalog"},
        {"текст": "Кошик", "дані": "cart"}
    ], [
        {"текст": "Мої замовлення", "дані": "orders"},
        {"текст": "Підтримка", "дані": "support"}
    ]]
    якщо адмін:
        Списки.додати(кнопки, [{"текст": "Адмін-панель", "дані": "admin"}])
    повернути кнопки

функція картка_послуги(назва, опис, ціна, код):
    повернути [[
        {"текст": назва, "дані": "service:" + код}
    ], [
        {"текст": "Замовити за " + ціна + " грн", "дані": "buy:" + код}
    ]]

коли бот.команда("/start"):
    адмін = бот.є_адмін(повідомлення.користувач.id)
    сесія = бот.сесія(повідомлення.користувач.id)
    сесія.встановити("імʼя", повідомлення.користувач.first_name)
    сесія.встановити("кошик", [])
    бот.відповісти(
        "Вітаю у магазині послуг для Roblox Studio! Обери розділ:",
        inline_кнопки = меню(адмін)
    )

коли бот.натиснули_кнопку("catalog"):
    бот.відповісти(
        "Каталог послуг:",
        inline_кнопки = [[
            {"текст": "Нова гра - 500 грн", "дані": "service:game"}
        ], [
            {"текст": "Скрипт Lua - 250 грн", "дані": "service:lua"}
        ], [
            {"текст": "UI для гри - 350 грн", "дані": "service:ui"}
        ], [
            {"текст": "Оптимізація - 200 грн", "дані": "service:opt"}
        ]]
    )

коли бот.натиснули_кнопку("service:game"):
    бот.відповісти("Створимо базову гру Roblox Studio під твою ідею.", inline_кнопки = картка_послуги("Створення гри", "", "500", "game"))

коли бот.натиснули_кнопку("service:lua"):
    бот.відповісти("Напишемо та протестуємо Lua-скрипт для твоєї гри.", inline_кнопки = картка_послуги("Lua-скрипт", "", "250", "lua"))

коли бот.натиснули_кнопку("service:ui"):
    бот.відповісти("Зробимо меню, кнопки та інтерфейс Roblox Studio.", inline_кнопки = картка_послуги("UI дизайн", "", "350", "ui"))

коли бот.натиснули_кнопку("service:opt"):
    бот.відповісти("Знайдемо повільні місця та оптимізуємо гру.", inline_кнопки = картка_послуги("Оптимізація", "", "200", "opt"))

коли бот.натиснули_кнопку("buy:game"):
    замовлення = бот.створити_замовлення(повідомлення.користувач.id, "Створення гри", 500)
    бот.відповісти("Замовлення створено:\n" + JSON.створити(замовлення))

коли бот.натиснули_кнопку("buy:lua"):
    замовлення = бот.створити_замовлення(повідомлення.користувач.id, "Lua-скрипт", 250)
    бот.відповісти("Замовлення створено:\n" + JSON.створити(замовлення))

коли бот.натиснули_кнопку("buy:ui"):
    замовлення = бот.створити_замовлення(повідомлення.користувач.id, "UI дизайн", 350)
    бот.відповісти("Замовлення створено:\n" + JSON.створити(замовлення))

коли бот.натиснули_кнопку("buy:opt"):
    замовлення = бот.створити_замовлення(повідомлення.користувач.id, "Оптимізація", 200)
    бот.відповісти("Замовлення створено:\n" + JSON.створити(замовлення))

коли бот.натиснули_кнопку("orders"):
    замовлення = бот.отримати_замовлення(повідомлення.користувач.id)
    бот.відповісти("Твої замовлення:\n" + JSON.створити(замовлення))

коли бот.натиснули_кнопку("admin"):
    якщо бот.є_адмін(повідомлення.користувач.id):
        бот.відповісти("Адмін-панель. Замовлення:\n" + JSON.створити(бот.отримати_замовлення()))
    інакше:
        бот.відповісти("Доступ заборонено.")

коли бот.натиснули_кнопку("support"):
    бот.відповісти("Підтримка: напиши @manager і вкажи номер замовлення.")

коли бот.отримав_текст("привіт"):
    бот.відповісти("Привіт! Натисни /start, щоб відкрити магазин.")

бот.запустити()